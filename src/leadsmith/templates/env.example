# Leadsmith settings. This file stays on your computer; never commit it.
# Easiest: edit these from the dashboard (uv run leadsmith → Settings).

# ── Sending through your Gmail (optional) ───────────────────────
# Needs 2-Step Verification + an App Password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
SENDER_NAME=
# Use \n for new lines
SENDER_SIGNATURE=
# Required for commercial email in many countries (e.g. CAN-SPAM)
POSTAL_ADDRESS=
OPT_OUT_LINE=If this isn't relevant, just reply "no" and I won't follow up.
# Safety: nothing is ever sent until this is true AND you approved the draft.
SEND_ENABLED=false
DAILY_SEND_LIMIT=25
# While the dashboard is open: send approved follow-ups when due, stop on reply.
AUTO_FOLLOWUPS=true

# ── Engine ──────────────────────────────────────────────────────
# The coding agent behind the dashboard: claude, codex, opencode or gemini.
AGENT_ENGINE=claude
# Optional model for that engine (its own model names). Empty = the engine's default.
AGENT_MODEL=
DECK_COLOR=#4f46e5

# ── Optional paid add-on (off unless set) ───────────────────────
# BetterContact verifies guessed emails, one person per click in the dashboard.
# Charged only when it finds a usable email. The agents never spend credits.
BETTERCONTACT_API_KEY=
